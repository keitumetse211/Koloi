<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kamohelo.pharaoh_motors.LoginController">

    <children>
        <!-- Gradient Background instead of image -->
        <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#0a0a1a" height="700.0" width="1100.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />

        <!-- Login Card Container -->
        <StackPane alignment="CENTER" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <VBox alignment="CENTER" maxWidth="450" spacing="25" style="-fx-background-color: rgba(20,20,40,0.95); -fx-background-radius: 35; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.6), 30, 0, 0, 15); -fx-border-color: rgba(233,69,96,0.3); -fx-border-radius: 35; -fx-border-width: 1.5;">

                <!-- Logo Section -->
                <VBox alignment="CENTER" spacing="10" style="-fx-padding: 40 40 0 40;">
                    <Label style="-fx-font-size: 70px;" text="🚗" />
                    <Label style="-fx-text-fill: #e94560; -fx-font-size: 28px; -fx-font-weight: bold; -fx-font-family: 'Arial Black';" text="PHARAOH MOTORS">
                        <font><Font name="Arial Black" size="28" /></font>
                    </Label>
                    <Label style="-fx-text-fill: #ffffff; -fx-font-size: 14px;" text="Vehicle Identification System" />
                    <Label style="-fx-text-fill: #8899aa; -fx-font-size: 12px;" text="Secure Access Portal" />
                </VBox>

                <!-- Divider -->
                <HBox alignment="CENTER" prefWidth="300">
                    <Label style="-fx-text-fill: #e94560; -fx-opacity: 0.4;" text="━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" />
                </HBox>

                <!-- Login Form -->
                <VBox spacing="18" style="-fx-padding: 0 45 0 45;">

                    <Label style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold; -fx-alignment: CENTER;" text="WELCOME BACK" />

                    <!-- Username -->
                    <VBox spacing="6">
                        <Label style="-fx-text-fill: #e94560; -fx-font-size: 12px; -fx-font-weight: bold;" text="USERNAME" />
                        <TextField fx:id="usernameField" promptText="Enter your username" style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-background-radius: 12; -fx-padding: 12 15; -fx-font-size: 14px; -fx-border-color: rgba(233,69,96,0.4); -fx-border-radius: 12;">
                            <padding><Insets left="15" right="15" /></padding>
                        </TextField>
                    </VBox>

                    <!-- Password -->
                    <VBox spacing="6">
                        <Label style="-fx-text-fill: #e94560; -fx-font-size: 12px; -fx-font-weight: bold;" text="PASSWORD" />
                        <PasswordField fx:id="passwordField" promptText="Enter your password" style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-background-radius: 12; -fx-padding: 12 15; -fx-font-size: 14px; -fx-border-color: rgba(233,69,96,0.4); -fx-border-radius: 12;">
                            <padding><Insets left="15" right="15" /></padding>
                        </PasswordField>
                    </VBox>

                    <!-- Show Password -->
                    <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 5 0;">
                        <CheckBox fx:id="showPasswordCheckBox" style="-fx-text-fill: #8899aa; -fx-font-size: 12px; -fx-cursor: hand;" text="Show Password">
                            <tooltip><Tooltip text="Toggle password visibility" /></tooltip>
                        </CheckBox>
                    </HBox>

                    <!-- Buttons -->
                    <HBox alignment="CENTER" spacing="25" style="-fx-padding: 10 0 0 0;">
                        <Button fx:id="loginButton" onAction="#handleLogin" style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-background-radius: 30; -fx-padding: 12 45; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(233,69,96,0.4), 10, 0, 0, 2);" text="LOGIN">
                            <tooltip><Tooltip text="Click to login" /></tooltip>
                        </Button>
                        <Button fx:id="cancelButton" onAction="#handleCancel" style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: #ccddee; -fx-background-radius: 30; -fx-padding: 12 45; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" text="CANCEL">
                            <tooltip><Tooltip text="Exit application" /></tooltip>
                        </Button>
                    </HBox>

                    <!-- Status -->
                    <VBox alignment="CENTER" spacing="10" style="-fx-padding: 5 0 0 0;">
                        <Label fx:id="statusLabel" style="-fx-text-fill: #ffd700; -fx-font-size: 12px;" wrapText="true" />
                        <ProgressIndicator fx:id="progressIndicator" prefHeight="35" prefWidth="35" style="-fx-progress-color: #e94560;" visible="false" />
                    </VBox>

                    <!-- Demo Credentials -->
                    <VBox alignment="CENTER" spacing="8" style="-fx-padding: 15 0 0 0;">
                        <Label style="-fx-text-fill: #8899aa; -fx-font-size: 11px;" text="Demo Accounts" />
                        <HBox alignment="CENTER" spacing="20">
                            <Label fx:id="adminLabel" style="-fx-text-fill: #00b894; -fx-font-size: 12px; -fx-cursor: hand; -fx-background-color: rgba(0,184,148,0.1); -fx-padding: 5 15; -fx-background-radius: 20;" text="Admin">
                                <tooltip><Tooltip text="Click to auto-fill admin credentials" /></tooltip>
                            </Label>
                            <Label fx:id="managerLabel" style="-fx-text-fill: #fdcb6e; -fx-font-size: 12px; -fx-cursor: hand; -fx-background-color: rgba(253,203,110,0.1); -fx-padding: 5 15; -fx-background-radius: 20;" text="Manager">
                                <tooltip><Tooltip text="Click to auto-fill manager credentials" /></tooltip>
                            </Label>
                            <Label fx:id="userLabel" style="-fx-text-fill: #6c5ce7; -fx-font-size: 12px; -fx-cursor: hand; -fx-background-color: rgba(108,92,231,0.1); -fx-padding: 5 15; -fx-background-radius: 20;" text="User">
                                <tooltip><Tooltip text="Click to auto-fill user credentials" /></tooltip>
                            </Label>
                        </HBox>
                    </VBox>

                    <!-- Credentials Info -->
                    <VBox alignment="CENTER" spacing="3" style="-fx-padding: 5 0 0 0;">
                        <Label style="-fx-text-fill: #555; -fx-font-size: 10px;" text="admin: admin123 | manager1: manager123 | user1: user123" />
                    </VBox>

                </VBox>

                <!-- Footer -->
                <Label style="-fx-text-fill: #444; -fx-font-size: 11px; -fx-padding: 0 0 35 0;" text="© 2026 Pharaoh Motors. All rights reserved." />

            </VBox>
        </StackPane>

    </children>
</AnchorPane>