                        <Label style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;" text="Insurance Management" />
                        <HBox spacing="20">
                           <VBox spacing="15" style="-fx-background-color: #1a1a2e; -fx-background-radius: 15; -fx-padding: 25;" HBox.hgrow="ALWAYS">
                              <Label style="-fx-text-fill: #e94560; -fx-font-size: 18px; -fx-font-weight: bold;" text="Add Insurance Policy" />
                              <ComboBox fx:id="insuranceVehicleCombo" promptText="Select Vehicle" />
                              <TextField fx:id="policyNumberField" promptText="Policy Number" />
                              <TextField fx:id="insurerNameField" promptText="Insurance Company" />
                              <DatePicker fx:id="startDatePicker" promptText="Start Date" />
                              <DatePicker fx:id="endDatePicker" promptText="End Date" />
