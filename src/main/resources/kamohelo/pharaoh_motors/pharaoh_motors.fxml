<AnchorPane fx:id="rootPane" prefHeight="900.0" prefWidth="1400.0" style="-fx-background-color: #0f0f1a;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kamohelo.pharaoh_motors.Pharaohmotors">

   <children>

      <!-- Sidebar Navigation Pane -->
      <Pane fx:id="sidebarPane" prefWidth="260.0" style="-fx-background-color: linear-gradient(to bottom, #1a1a2e, #16213e); -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0, 2, 0);" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">

         <!-- Toggle Button -->
         <Button fx:id="toggleSidebarBtn" layoutX="220.0" layoutY="10.0" onAction="#toggleSidebar" prefHeight="30.0" prefWidth="30.0" style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-background-radius: 15; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" text="◀" />

         <VBox layoutX="42.0" prefHeight="900.0" prefWidth="254.0">

            <!-- Logo Section -->
            <VBox alignment="CENTER" prefHeight="206.0" prefWidth="281.0" spacing="10" style="-fx-padding: 30 20 30 20;">
               <Label style="-fx-font-size: 48px;" text="🚗" />
               <Label style="-fx-text-fill: #e94560; -fx-font-size: 18px; -fx-font-weight: bold; -fx-font-family: 'Arial Black';" text="PHARAOH MOTORS" />
               <Label style="-fx-text-fill: #8899aa; -fx-font-size: 11px;" text="Vehicle Identification System" />
               <Separator prefWidth="180" style="-fx-background-color: #e94560; -fx-pref-height: 2;" />
            </VBox>

            <!-- Navigation Buttons -->
            <VBox spacing="8" style="-fx-padding: 20 15 20 15;">
               <Button onAction="#handleDashboard" prefWidth="230" style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 12 20; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;" text="🏠 DASHBOARD" />
               <Button onAction="#handleAddVehicle" prefWidth="230" style="-fx-background-color: transparent; -fx-text-fill: #ccddee; -fx-background-radius: 10; -fx-padding: 12 20; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;" text="📝 REGISTER" />
               <Button onAction="#handleWorkshop" prefWidth="230" style="-fx-background-color: transparent; -fx-text-fill: #ccddee; -fx-background-radius: 10; -fx-padding: 12 20; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;" text="🔧 WORKSHOP" />
               <Button onAction="#handleInsurance" prefWidth="230" style="-fx-background-color: transparent; -fx-text-fill: #ccddee; -fx-background-radius: 10; -fx-padding: 12 20; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;" text="📋 INSURANCE" />
               <Button onAction="#handlePoliceModule" prefWidth="230" style="-fx-background-color: transparent; -fx-text-fill: #ccddee; -fx-background-radius: 10; -fx-padding: 12 20; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;" text="👮 POLICE" />
               <Button onAction="#handleCustomerSupport" prefWidth="230" style="-fx-background-color: transparent; -fx-text-fill: #ccddee; -fx-background-radius: 10; -fx-padding: 12 20; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;" text="💬 SUPPORT" />
               <Button onAction="#handleReports" prefWidth="230" style="-fx-background-color: transparent; -fx-text-fill: #ccddee; -fx-background-radius: 10; -fx-padding: 12 20; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;" text="📊 REPORTS" />
               <Button onAction="#handleDemoFeatures" prefWidth="230" style="-fx-background-color: transparent; -fx-text-fill: #ccddee; -fx-background-radius: 10; -fx-padding: 12 20; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;" text="🎮 DEMO" />
            </VBox>

            <!-- User Section -->
            <VBox prefHeight="131.0" prefWidth="168.0" spacing="10" style="-fx-padding: 20; -fx-background-color: rgba(0,0,0,0.3);">
               <HBox alignment="CENTER_LEFT" spacing="10">
                  <Label style="-fx-font-size: 32px;" text="👤" />
                  <VBox>
                     <Label fx:id="userLabel" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;" text="Guest" />
                     <Label fx:id="roleLabel" style="-fx-text-fill: #8899aa; -fx-font-size: 11px;" text="User" />
                  </VBox>
               </HBox>
               <Button onAction="#handleLogout" style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 15; -fx-font-size: 12px; -fx-cursor: hand;" text="🚪 LOGOUT" />
            </VBox>

            <Region prefHeight="0.0" prefWidth="260.0" VBox.vgrow="ALWAYS" />
         </VBox>
      </Pane>

      <!-- Sidebar Reveal Button (when hidden) -->
      <Button fx:id="revealSidebarBtn" layoutX="5.0" layoutY="400.0" onAction="#toggleSidebar" prefHeight="50.0" prefWidth="30.0" style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-background-radius: 0 10 10 0; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" text="▶" visible="false" AnchorPane.leftAnchor="0.0">
         <tooltip><Tooltip text="Show Menu" /></tooltip>
      </Button>

      <!-- Main Content Pane -->
      <Pane fx:id="contentPane" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="260.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

         <VBox layoutX="0.0" layoutY="0.0" prefHeight="900.0" prefWidth="1140.0" spacing="0">

            <!-- ============================================ -->
            <!-- MENU BAR - ADDED FOR ASSIGNMENT REQUIREMENT -->
            <!-- ============================================ -->
            <MenuBar style="-fx-background-color: #1a1a2e; -fx-border-color: #2a2a3e; -fx-border-width: 0 0 1 0;">
               <Menu text="File">
                  <MenuItem text="Export Data" onAction="#handleExportData"/>
                  <MenuItem text="Import Data" onAction="#handleImportData"/>
                  <SeparatorMenuItem/>
                  <MenuItem text="Exit" onAction="#handleExit"/>
               </Menu>
               <Menu text="Reports">
                  <MenuItem text="All Vehicles Report" onAction="#handleGenerateAllVehiclesReport"/>
                  <MenuItem text="Insurance Report" onAction="#handleInsuranceReport"/>
                  <MenuItem text="Violation Report" onAction="#handleViolationReport"/>
                  <SeparatorMenuItem/>
                  <MenuItem text="Export to CSV" onAction="#handleExportReport"/>
               </Menu>
               <Menu text="Database">
                  <MenuItem text="Backup Data" onAction="#handleBackupData"/>
                  <MenuItem text="View Audit Log" onAction="#handleViewAuditLog"/>
                  <MenuItem text="System Statistics" onAction="#handleShowStatistics"/>
               </Menu>
               <Menu text="Help">
                  <MenuItem text="User Guide" onAction="#handleUserGuide"/>
                  <MenuItem text="Documentation" onAction="#handleDocumentation"/>
                  <SeparatorMenuItem/>
                  <MenuItem text="About" onAction="#handleAbout"/>
               </Menu>
            </MenuBar>

            <!-- Top Header -->
            <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: #1a1a2e; -fx-padding: 15 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);">
               <Label style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" text="Vehicle Identification System">
                  <font><Font name="Arial Black" size="22" /></font>
               </Label>
               <Region HBox.hgrow="ALWAYS" />
               <Label fx:id="timeLabel" style="-fx-text-fill: #00b894; -fx-font-size: 14px; -fx-font-family: monospace;" text="--:--:--" />
               <Button style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 18px; -fx-cursor: hand;" text="🔔" />
               <Button style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 18px; -fx-cursor: hand;" text="⚙️" />
            </HBox>

            <!-- Content Area -->
            <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: #0f0f1a;" VBox.vgrow="ALWAYS">

               <TabPane fx:id="mainTabPane" style="-fx-background-color: transparent; -fx-tab-min-height: 45px; -fx-tab-max-height: 45px; -fx-tab-min-width: 120px;">

                  <!-- Tab 1: Dashboard -->
                  <Tab closable="false" text="🏠 DASHBOARD">
                     <VBox spacing="20" style="-fx-padding: 25;">
                        <HBox alignment="CENTER_LEFT" style="-fx-background-color: linear-gradient(to right, #e94560, #c72a48); -fx-background-radius: 15; -fx-padding: 25;">
                           <VBox>
                              <Label style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;" text="Welcome Back!" />
                              <Label fx:id="statusLabel" style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 14px;" text="System Ready" />
                           </VBox>
                           <Region HBox.hgrow="ALWAYS" />
                           <Label style="-fx-font-size: 64px;" text="🚗" />
                        </HBox>

                        <HBox spacing="20">
                           <VBox style="-fx-background-color: #1a1a2e; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);" HBox.hgrow="ALWAYS">
                              <Label style="-fx-font-size: 32px;" text="🚗" />
                              <Label style="-fx-text-fill: #8899aa; -fx-font-size: 12px;" text="Total Vehicles" />
                              <Label fx:id="totalVehiclesLabel" style="-fx-text-fill: #e94560; -fx-font-size: 36px; -fx-font-weight: bold;" text="0" />
                           </VBox>
                           <VBox style="-fx-background-color: #1a1a2e; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);" HBox.hgrow="ALWAYS">
                              <Label style="-fx-font-size: 32px;" text="👥" />
                              <Label style="-fx-text-fill: #8899aa; -fx-font-size: 12px;" text="Total Owners" />
                              <Label fx:id="totalOwnersLabel" style="-fx-text-fill: #00b894; -fx-font-size: 36px; -fx-font-weight: bold;" text="0" />
                           </VBox>
                           <VBox style="-fx-background-color: #1a1a2e; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);" HBox.hgrow="ALWAYS">
                              <Label style="-fx-font-size: 32px;" text="🔧" />
                              <Label style="-fx-text-fill: #8899aa; -fx-font-size: 12px;" text="Service Records" />
                              <Label fx:id="serviceCountLabel" style="-fx-text-fill: #fdcb6e; -fx-font-size: 36px; -fx-font-weight: bold;" text="0" />
                           </VBox>
                           <VBox style="-fx-background-color: #1a1a2e; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);" HBox.hgrow="ALWAYS">
                              <Label style="-fx-font-size: 32px;" text="⚠️" />
                              <Label style="-fx-text-fill: #8899aa; -fx-font-size: 12px;" text="Violations" />
                              <Label fx:id="violationCountLabel" style="-fx-text-fill: #ff6b6b; -fx-font-size: 36px; -fx-font-weight: bold;" text="0" />
                           </VBox>
                           <VBox style="-fx-background-color: #1a1a2e; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);" HBox.hgrow="ALWAYS">
                              <Label style="-fx-font-size: 32px;" text="📋" />
                              <Label style="-fx-text-fill: #8899aa; -fx-font-size: 12px;" text="Insurance" />
                              <Label fx:id="insuranceCountLabel" style="-fx-text-fill: #4ecdc4; -fx-font-size: 36px; -fx-font-weight: bold;" text="0" />
                           </VBox>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #1a1a2e; -fx-background-radius: 15; -fx-padding: 20;">
                           <Label style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;" text="System Performance:" />
                           <ProgressBar fx:id="progressBar" prefWidth="400" progress="0.75" style="-fx-accent: #00b894; -fx-background-radius: 10;" />
                           <ProgressIndicator fx:id="progressIndicator" prefHeight="35" prefWidth="35" progress="0.75" style="-fx-progress-color: #00b894;" />
                           <Label style="-fx-text-fill: #00b894; -fx-font-size: 12px; -fx-font-weight: bold;" text="75% Loaded" />
                        </HBox>

                        <Label style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" text="📊 RECENT VEHICLES" />
                        <TableView fx:id="vehicleTable" prefHeight="350" style="-fx-background-color: #1a1a2e; -fx-background-radius: 10; -fx-border-color: #2a2a3e; -fx-border-radius: 10;">
                           <columns>
                              <TableColumn fx:id="regColumn" prefWidth="150" text="REGISTRATION" />
                              <TableColumn fx:id="makeColumn" prefWidth="120" text="MAKE" />
                              <TableColumn fx:id="modelColumn" prefWidth="120" text="MODEL" />
                              <TableColumn fx:id="yearColumn" prefWidth="80" text="YEAR" />
                              <TableColumn fx:id="ownerColumn" prefWidth="200" text="OWNER" />
                              <TableColumn fx:id="phoneColumn" prefWidth="150" text="PHONE" />
                           </columns>
                        </TableView>

                        <HBox alignment="CENTER" spacing="15">
                           <Button fx:id="addButton" onAction="#handleAddVehicle" style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-background-radius: 25; -fx-padding: 12 25; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;" text="➕ ADD VEHICLE" />
                           <Button onAction="#handleRefresh" style="-fx-background-color: #2a2a3e; -fx-text-fill: white; -fx-background-radius: 25; -fx-padding: 12 25; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;" text="🔄 REFRESH" />
                           <Button fx:id="deleteButton" onAction="#handleDeleteVehicle" style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-background-radius: 25; -fx-padding: 12 25; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;" text="🗑️ DELETE" />
                           <Button onAction="#handleViewHistory" style="-fx-background-color: #00b894; -fx-text-fill: white; -fx-background-radius: 25; -fx-padding: 12 25; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;" text="📜 HISTORY" />
                        </HBox>
                     </VBox>
                  </Tab>

                  <!-- Tab 2: Register Vehicle -->
                  <Tab closable="false" text="📝 REGISTER VEHICLE">
                     <ScrollPane fitToWidth="true" style="-fx-background: transparent;">
                        <VBox spacing="25" style="-fx-padding: 30;">
                           <Label style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;" text="New Vehicle Registration" />
                           <GridPane hgap="30" vgap="20">
                              <VBox spacing="15" style="-fx-background-color: #1a1a2e; -fx-background-radius: 15; -fx-padding: 25;" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                 <Label style="-fx-text-fill: #e94560; -fx-font-size: 18px; -fx-font-weight: bold;" text="VEHICLE INFORMATION" />
                                 <Separator />
                                 <HBox alignment="CENTER_LEFT" spacing="15">
                                    <Label prefWidth="150" style="-fx-text-fill: white; -fx-font-weight: bold;" text="Registration Number:" />
                                    <TextField fx:id="regNumberField" prefWidth="280" promptText="ABC-123" style="-fx-background-radius: 8; -fx-padding: 10;" />
                                 </HBox>
                                 <HBox alignment="CENTER_LEFT" spacing="15">
                                    <Label prefWidth="150" style="-fx-text-fill: white; -fx-font-weight: bold;" text="Make:" />
                                    <ComboBox fx:id="makeComboBox" editable="true" prefWidth="280" promptText="Select Make" style="-fx-background-radius: 8; -fx-padding: 10;" />
                                 </HBox>
                                 <HBox alignment="CENTER_LEFT" spacing="15">
                                    <Label prefWidth="150" style="-fx-text-fill: white; -fx-font-weight: bold;" text="Model:" />
                                    <TextField fx:id="modelField" prefWidth="280" promptText="Camry" style="-fx-background-radius: 8; -fx-padding: 10;" />
                                 </HBox>
                                 <HBox alignment="CENTER_LEFT" spacing="15">
                                    <Label prefWidth="150" style="-fx-text-fill: white; -fx-font-weight: bold;" text="Year:" />
                                    <TextField fx:id="yearField" prefWidth="120" promptText="2024" style="-fx-background-radius: 8; -fx-padding: 10;" />
                                 </HBox>
                              </VBox>
                              <VBox spacing="15" style="-fx-background-color: #1a1a2e; -fx-background-radius: 15; -fx-padding: 25;" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                 <Label style="-fx-text-fill: #00b894; -fx-font-size: 18px; -fx-font-weight: bold;" text="OWNER INFORMATION" />
                                 <Separator />
                                 <HBox alignment="CENTER_LEFT" spacing="15">
                                    <Label prefWidth="120" style="-fx-text-fill: white; -fx-font-weight: bold;" text="Full Name:" />
                                    <TextField fx:id="ownerField" prefWidth="280" promptText="John Doe" style="-fx-background-radius: 8; -fx-padding: 10;" />
                                 </HBox>
                                 <HBox alignment="CENTER_LEFT" spacing="15">
                                    <Label prefWidth="120" style="-fx-text-fill: white; -fx-font-weight: bold;" text="Email:" />
                                    <TextField fx:id="emailField" prefWidth="280" promptText="john@example.com" style="-fx-background-radius: 8; -fx-padding: 10;" />
                                 </HBox>
                                 <HBox alignment="CENTER_LEFT" spacing="15">
                                    <Label prefWidth="120" style="-fx-text-fill: white; -fx-font-weight: bold;" text="Phone:" />
                                    <TextField fx:id="phoneField" prefWidth="280" promptText="+27 XX XXX XXXX" style="-fx-background-radius: 8; -fx-padding: 10;" />
                                 </HBox>
                              </VBox>
                              <columnConstraints>
                                 <ColumnConstraints />
                                 <ColumnConstraints />
                              </columnConstraints>
                              <rowConstraints>
                                 <RowConstraints />
                              </rowConstraints>
                           </GridPane>
                           <HBox alignment="CENTER" spacing="20">
                              <Button onAction="#handleRegisterNewVehicle" style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-background-radius: 25; -fx-padding: 14 45; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" text="✅ REGISTER" />
                              <Button onAction="#handleClearForm" style="-fx-background-color: #2a2a3e; -fx-text-fill: white; -fx-background-radius: 25; -fx-padding: 14 45; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" text="🗑️ CLEAR" />
                           </HBox>
                        </VBox>
                     </ScrollPane>
                  </Tab>

                  <!-- Tab 3: Workshop -->
                  <Tab closable="false" text="🔧 WORKSHOP">
                     <VBox spacing="20" style="-fx-padding: 25;">
                        <Label style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;" text="Service and Maintenance" />
                        <HBox spacing="20">
                           <VBox spacing="15" style="-fx-background-color: #1a1a2e; -fx-background-radius: 15; -fx-padding: 25;" HBox.hgrow="ALWAYS">
                              <Label style="-fx-text-fill: #e94560; -fx-font-size: 18px; -fx-font-weight: bold;" text="Add Service Record" />
                              <ComboBox fx:id="serviceVehicleCombo" promptText="Select Vehicle" />
                              <DatePicker fx:id="serviceDatePicker" promptText="Service Date" />
                              <ComboBox fx:id="serviceTypeCombo" promptText="Service Type" />
                              <TextArea fx:id="serviceDescriptionArea" prefHeight="80" promptText="Service Description" />
                              <TextField fx:id="serviceCostField" promptText="Cost (USD)" />
                              <Button onAction="#handleAddServiceRecord" style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 12; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" text="➕ ADD SERVICE" />
                           </VBox>
                           <VBox spacing="15" style="-fx-background-color: #1a1a2e; -fx-background-radius: 15; -fx-padding: 25;" HBox.hgrow="ALWAYS">
                              <Label style="-fx-text-fill: #00b894; -fx-font-size: 18px; -fx-font-weight: bold;" text="Service History" />
                              <ComboBox fx:id="historyVehicleCombo" promptText="Select Vehicle" />
                              <Button onAction="#handleViewServiceHistory" style="-fx-background-color: #00b894; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 10; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;" text="🔍 VIEW HISTORY" />
                              <ListView fx:id="serviceHistoryList" prefHeight="200" />
                              <Label style="-fx-text-fill: white; -fx-font-weight: bold;" text="Total Spent:" />
                              <Label fx:id="totalServiceCost" style="-fx-text-fill: #fdcb6e; -fx-font-size: 24px; -fx-font-weight: bold;" text="USD 0.00" />
                           </VBox>
                        </HBox>
                     </VBox>
                  </Tab>

                  <!-- Rest of your tabs remain the same... -->
